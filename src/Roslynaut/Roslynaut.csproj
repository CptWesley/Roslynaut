<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- dotnet tool install -g Roslynaut. The package holds the publish output, so the helper hosts beside the server too. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>roslynaut</ToolCommandName>
    <RollForward>Major</RollForward>
    <Version>0.1.0</Version>
    <Authors>Wesley Baartman</Authors>
    <Copyright>Copyright (c) 2026 Wesley Baartman</Copyright>
    <Description>An MCP server that exposes Roslyn and MSBuild to agents: navigation, analysis, refactoring, builds and tests, IL/JIT disassembly, decompilation, process inspection and debugging of C# projects.</Description>
    <PackageTags>mcp;roslyn;msbuild;csharp;agents</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/CptWesley/Roslynaut</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CptWesley/Roslynaut</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Roslynaut.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Buildalyzer" Version="9.0.0" />
    <PackageReference Include="ICSharpCode.Decompiler" Version="11.1.0.9782" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="4.2.751201" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="MSBuild.StructuredLogger" Version="2.3.246" />
    <PackageReference Include="NuGet.Credentials" Version="7.9.0" />
    <PackageReference Include="NuGet.ProjectModel" Version="7.9.0" />
    <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Roslynaut.CallCounter\Roslynaut.CallCounter.csproj" />
    <ProjectReference Include="..\Roslynaut.JitHost\Roslynaut.JitHost.csproj" />
    <ProjectReference Include="..\Roslynaut.ScriptHost\Roslynaut.ScriptHost.csproj" />
  </ItemGroup>

</Project>
