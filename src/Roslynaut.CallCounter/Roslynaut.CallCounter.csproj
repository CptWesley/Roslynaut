<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The oldest supported .NET, so programs built for any .NET from it on can load it as their startup hook. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Shipped inside the Roslynaut tool package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
